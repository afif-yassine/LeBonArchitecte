{
  "name": "le-bon-architecte",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite",
    "engine": "node --watch --disable-warning=ExperimentalWarning server/index.ts",
    "engine:reset": "node -e \"for (const f of ['lba.db','lba.db-wal','lba.db-shm']) require('fs').rmSync('.lba/'+f,{force:true})\"",
    "test": "node --test --disable-warning=ExperimentalWarning server/engine.test.ts",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "pdf": "node scripts/pdf.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "fastify": "^5.12.8",
    "lucide-react": "^1.74.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
